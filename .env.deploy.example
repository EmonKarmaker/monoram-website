# =====================================================================
#  Monoram Jewellers — the server login the deploy script uses
#
#  HOW TO USE THIS FILE
#    1. Make a copy of it in this same folder.
#    2. Name the copy exactly:  .env.deploy
#       (with the dot at the front, and NO .example on the end)
#    3. Fill in the five values below from cPanel.
#    4. Save it.
#
#  .env.deploy is listed in .gitignore, so it never goes to GitHub and
#  the password never leaves this computer. This .example file has no
#  real password in it and is safe to keep in the repository.
#
#  Where each value comes from is explained in DEPLOY.md, step 2.
# =====================================================================


# The FTP server address. In cPanel: FTP Accounts → Configure FTP Client
# → "FTP Server". It is usually ftp.yourdomain.com, and sometimes the
# server's own name. Do NOT put ftp:// in front of it.
FTP_HOST=ftp.example.com

# The FTP username. cPanel almost always makes this the full
# user@domain form — for example  deploy@monoram.com.bd  — even though
# the box you typed in only asked for the first part. Copy it exactly as
# cPanel shows it under FTP Accounts, including the @ and the domain.
FTP_USER=deploy@example.com

# The password you set when you created the FTP account.
# If it contains a # character, wrap the whole value in double quotes.
FTP_PASS=

# The folder on the server that the website lives in.
#
# This is USUALLY public_html — but not always. If the domain is an
# add-on domain or points at a subfolder, it will be something like
# public_html/monoram  or  public_html/shop.
#
# The correct answer is: the folder that ALREADY CONTAINS the live
# index.html. DEPLOY.md step 6 shows how to check. Getting this wrong is
# the single most common reason an upload appears to succeed and the
# website does not change.
#
# No slash at the start, no slash at the end.
FTP_DIR=public_html

# The address of the finished site. The script prints this at the end so
# you can tap it to check the result. Include https:// at the front.
SITE_URL=https://example.com

# The FTP port. Leave this at 21 unless your host told you otherwise.
# 21 is correct for FTPS (explicit TLS), which is what the script uses.
FTP_PORT=21

# Certificate checking.
#
# Leave this as "no" and try a deploy first. Plenty of shared hosts use
# a certificate that does not exactly match the FTP address, and the
# upload then stops with a "certificate" or "SSL" error. Only if that
# happens, change this to yes.
#
# What it costs: the connection is still encrypted, but the script stops
# verifying that the server is who it claims to be. On a home or shop
# connection that is an acceptable trade; on public wifi, wait until you
# are on a network you trust.
FTP_INSECURE=no
